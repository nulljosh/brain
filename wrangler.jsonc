{
  "observability": { "enabled": true },
  "name": "brain",
  "main": "src/index.ts",
  "workers_dev": false,
  "routes": [{ "pattern": "brain.jaybulb.com", "custom_domain": true }],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "compatibility_date": "2026-08-31",
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VEC", "index_name": "brain" }]
}
